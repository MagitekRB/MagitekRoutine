<UserControl x:Class="Magitek.Views.UserControls.Astrologian.FightLogic"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:Magitek.Properties"
             xmlns:controls="clr-namespace:Magitek.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Magitek.ViewModels"
             d:DesignHeight="400"
             d:DesignWidth="500"
             mc:Ignorable="d">

    <UserControl.DataContext>
        <Binding Source="{x:Static viewModels:BaseSettings.Instance}"/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <ResourceDictionary Source="/Magitek;component/Styles/Magitek.xaml"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
        <controls:SettingsBlock Margin="0,5"
                                Background="{DynamicResource ClassSelectorBackground}">
            <StackPanel Margin="5"
                        Orientation="Vertical">
                <TextBlock Margin="3"
                           Style="{DynamicResource TextBlockDefault}"
                           TextWrapping="Wrap">
                    <Run Text="{x:Static properties:Resources.Generic_Fight_Logic}"/>: <LineBreak/>
                    <Run Text="{x:Static properties:Resources.Generic_Fight_Logic_Description}"/> <LineBreak/>
                    <LineBreak/>
                    <Run Text="{x:Static properties:Resources.Generic_Fight_Logic_Limitation}"/>
                </TextBlock>
                <TextBlock Margin="0,5"
                           Style="{DynamicResource TextBlockDefault}"
                           TextWrapping="Wrap"
                           Text="{x:Static properties:Resources.Generic_Tankbusters}"/>
                <StackPanel Margin="5">
                    <CheckBox Content="{x:Static properties:Resources.Astrologian_Content_FL_Exaltation}"
                              IsChecked="{Binding AstrologianSettings.FightLogicExaltation, Mode=TwoWay}"
                              Style="{DynamicResource CheckBoxFlat}"/>
                    <CheckBox Content="{x:Static properties:Resources.Astrologian_Content_FL_Celestial_Intersection}"
                              IsChecked="{Binding AstrologianSettings.FightLogicCelestialIntersection, Mode=TwoWay}"
                              Style="{DynamicResource CheckBoxFlat}"/>
                </StackPanel>
                <TextBlock Margin="0,5"
                           Style="{DynamicResource TextBlockDefault}"
                           TextWrapping="Wrap"
                           Text="{x:Static properties:Resources.Astrologian_Text_Party_AoE}"/>
                <StackPanel Margin="5">
                    <CheckBox Content="{x:Static properties:Resources.Astrologian_Content_FL_Neutral_Sect}"
                              IsChecked="{Binding AstrologianSettings.FightLogicNeutralSect, Mode=TwoWay}"
                              Style="{DynamicResource CheckBoxFlat}"/>
                    <CheckBox Content="{x:Static properties:Resources.Astrologian_Content_FL_Earthly_Star}"
                              IsChecked="{Binding AstrologianSettings.FightLogicEarthlyStar, Mode=TwoWay}"
                              Style="{DynamicResource CheckBoxFlat}"/>
                    <StackPanel Margin="18,0,0,0">
                        <CheckBox Content="{x:Static properties:Resources.Astrologian_Content_FL_Earthly_Star_Center}"
                                  IsChecked="{Binding AstrologianSettings.EarthlyStarCenterParty, Mode=TwoWay}"
                                  Style="{DynamicResource CheckBoxFlat}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Margin="0,0,4,0"
                                  Content="{x:Static properties:Resources.Astrologian_Content_FL_Collective_Unconscious}"
                                  IsChecked="{Binding AstrologianSettings.FightLogicCollectiveUnconscious, Mode=TwoWay}"
                                  Style="{DynamicResource CheckBoxFlat}"/>
                        <controls:Numeric MaxValue="8" MinValue="1" Value="{Binding AstrologianSettings.CollectiveUnconsciousAllies, Mode=TwoWay}"/>
                        <TextBlock Margin="2,0,0,0"
                                   Style="{DynamicResource TextBlockDefault}"
                                   Text="{x:Static properties:Resources.Astrologian_Text_FL_Allies_In_Range}"/>
                    </StackPanel>
                    <CheckBox Content="{x:Static properties:Resources.Astrologian_Content_FL_Horoscope}"
                              IsChecked="{Binding AstrologianSettings.FightLogicHoroscope, Mode=TwoWay}"
                              Style="{DynamicResource CheckBoxFlat}"/>
                    <CheckBox Content="{x:Static properties:Resources.Astrologian_Content_FL_Aspected_Helios}"
                              IsChecked="{Binding AstrologianSettings.FightLogicAspectedHelios, Mode=TwoWay}"
                              Style="{DynamicResource CheckBoxFlat}"/>
                    <CheckBox Content="{x:Static properties:Resources.Astrologian_Content_FL_Macrocosmos}"
                              IsChecked="{Binding AstrologianSettings.FightLogic_Macrocosmos, Mode=TwoWay}"
                              Style="{DynamicResource CheckBoxFlat}"/>
                    <CheckBox Content="{x:Static properties:Resources.Astrologian_Content_FL_Lightspeed}"
                              IsChecked="{Binding AstrologianSettings.FightLogic_Lightspeed, Mode=TwoWay}"
                              Style="{DynamicResource CheckBoxFlat}"/>
                    <CheckBox Content="{x:Static properties:Resources.Astrologian_Content_FL_Knockback}"
                              IsChecked="{Binding AstrologianSettings.FightLogicKnockback, Mode=TwoWay}"
                              Style="{DynamicResource CheckBoxFlat}"/>
                </StackPanel>
            </StackPanel>
        </controls:SettingsBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
