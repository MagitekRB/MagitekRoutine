<UserControl x:Class="Magitek.Views.UserControls.VariantDungeon.General"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:properties="clr-namespace:Magitek.Properties"
             xmlns:controls="clr-namespace:Magitek.Controls"
             xmlns:variantDungeon="clr-namespace:Magitek.Models.VariantDungeon">

    <UserControl.DataContext>
        <Binding Source="{x:Static variantDungeon:VariantDungeonSettings.Instance}"/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <ResourceDictionary Source="/Magitek;component/Styles/Magitek.xaml"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">

            <!-- General Settings -->
            <controls:SettingsBlock Margin="0,5"
                                    Background="{DynamicResource ClassSelectorBackground}">
                <StackPanel Margin="5">
                    <TextBlock Style="{DynamicResource TextBlockSection}"
                               Text="{x:Static properties:Resources.Generic_General_Settings}"/>

                    <StackPanel Margin="5"
                                Orientation="Horizontal">
                        <CheckBox Content="{x:Static properties:Resources.VariantDungeon_Content_Enable}"
                                  IsChecked="{Binding Enable, Mode=TwoWay}"
                                  Style="{DynamicResource CheckBoxFlat}"/>
                    </StackPanel>

                    <TextBlock Margin="5"
                               Style="{DynamicResource TextBlockDefault}"
                               TextWrapping="Wrap"
                               FontStyle="Italic"
                               Text="{x:Static properties:Resources.VariantDungeon_Text_Description}"/>
                </StackPanel>
            </controls:SettingsBlock>

            <!-- Variant Cure -->
            <controls:SettingsBlock Margin="0,5"
                                    Background="{DynamicResource ClassSelectorBackground}">
                <StackPanel Margin="5">
                    <TextBlock Style="{DynamicResource TextBlockSection}"
                               Text="{x:Static properties:Resources.VariantDungeon_Text_Healing}"/>

                    <StackPanel Margin="5"
                                Orientation="Horizontal">
                        <CheckBox Content="{x:Static properties:Resources.VariantDungeon_Content_UseVariantCure}"
                                  IsChecked="{Binding UseVariantCure, Mode=TwoWay}"
                                  Style="{DynamicResource CheckBoxFlat}"/>
                        <controls:Numeric Value="{Binding VariantCureHealthPercent, Mode=TwoWay}"
                                         Margin="5,0,0,0"
                                         MaxValue="100"
                                         MinValue="1"/>
                    </StackPanel>

                    <StackPanel Margin="5"
                                Orientation="Horizontal">
                        <CheckBox Content="{x:Static properties:Resources.VariantDungeon_Content_VariantCureOnAllies}"
                                  IsChecked="{Binding VariantCureOnAllies, Mode=TwoWay}"
                                  Style="{DynamicResource CheckBoxFlat}"/>
                        <controls:Numeric Value="{Binding VariantCureAllyHealthPercent, Mode=TwoWay}"
                                         Margin="5,0,0,0"
                                         MaxValue="100"
                                         MinValue="1"/>
                    </StackPanel>

                    <TextBlock Margin="5"
                               Style="{DynamicResource TextBlockDefault}"
                               TextWrapping="Wrap"
                               FontStyle="Italic"
                               Foreground="LightBlue"
                               Text="{x:Static properties:Resources.VariantDungeon_Text_VariantCureDescription}"/>
                </StackPanel>
            </controls:SettingsBlock>

            <!-- Variant Ultimatum -->
            <controls:SettingsBlock Margin="0,5"
                                    Background="{DynamicResource ClassSelectorBackground}">
                <StackPanel Margin="5">
                    <TextBlock Style="{DynamicResource TextBlockSection}"
                               Text="{x:Static properties:Resources.VariantDungeon_Text_Aggro}"/>

                    <StackPanel Margin="5"
                                Orientation="Horizontal">
                        <CheckBox Content="{x:Static properties:Resources.VariantDungeon_Content_UseVariantUltimatum}"
                                  IsChecked="{Binding UseVariantUltimatum, Mode=TwoWay}"
                                  Style="{DynamicResource CheckBoxFlat}"/>
                    </StackPanel>

                    <TextBlock Margin="5"
                               Style="{DynamicResource TextBlockDefault}"
                               TextWrapping="Wrap"
                               FontStyle="Italic"
                               Foreground="LightBlue"
                               Text="{x:Static properties:Resources.VariantDungeon_Text_VariantUltimatumDescription}"/>
                </StackPanel>
            </controls:SettingsBlock>

            <!-- Variant Raise -->
            <controls:SettingsBlock Margin="0,5"
                                    Background="{DynamicResource ClassSelectorBackground}">
                <StackPanel Margin="5">
                    <TextBlock Style="{DynamicResource TextBlockSection}"
                               Text="{x:Static properties:Resources.VariantDungeon_Text_Resurrection}"/>

                    <StackPanel Margin="5"
                                Orientation="Horizontal">
                        <CheckBox Content="{x:Static properties:Resources.VariantDungeon_Content_UseVariantRaise}"
                                  IsChecked="{Binding UseVariantRaise, Mode=TwoWay}"
                                  Style="{DynamicResource CheckBoxFlat}"/>
                    </StackPanel>

                    <StackPanel Margin="5"
                                Orientation="Horizontal">
                        <CheckBox Content="{x:Static properties:Resources.VariantDungeon_Content_UseSwiftcastForRaise}"
                                  IsChecked="{Binding UseSwiftcastForVariantRaise, Mode=TwoWay}"
                                  Style="{DynamicResource CheckBoxFlat}"/>
                    </StackPanel>

                    <StackPanel Margin="5"
                                Orientation="Horizontal">
                        <CheckBox Content="{x:Static properties:Resources.VariantDungeon_Content_SlowcastVariantRaise}"
                                  IsChecked="{Binding SlowcastVariantRaise, Mode=TwoWay}"
                                  Style="{DynamicResource CheckBoxFlat}"/>
                    </StackPanel>

                    <TextBlock Margin="5"
                               Style="{DynamicResource TextBlockDefault}"
                               TextWrapping="Wrap"
                               FontStyle="Italic"
                               Foreground="LightBlue"
                               Text="{x:Static properties:Resources.VariantDungeon_Text_VariantRaiseDescription}"/>
                </StackPanel>
            </controls:SettingsBlock>

            <!-- Variant Spirit Dart -->
            <controls:SettingsBlock Margin="0,5"
                                    Background="{DynamicResource ClassSelectorBackground}">
                <StackPanel Margin="5">
                    <TextBlock Style="{DynamicResource TextBlockSection}"
                               Text="{x:Static properties:Resources.VariantDungeon_Text_Damage}"/>

                    <StackPanel Margin="5"
                                Orientation="Horizontal">
                        <CheckBox Content="{x:Static properties:Resources.VariantDungeon_Content_UseVariantSpiritDart}"
                                  IsChecked="{Binding UseVariantSpiritDart, Mode=TwoWay}"
                                  Style="{DynamicResource CheckBoxFlat}"/>
                    </StackPanel>

                    <TextBlock Margin="5"
                               Style="{DynamicResource TextBlockDefault}"
                               TextWrapping="Wrap"
                               FontStyle="Italic"
                               Foreground="LightBlue"
                               Text="{x:Static properties:Resources.VariantDungeon_Text_VariantSpiritDartDescription}"/>
                </StackPanel>
            </controls:SettingsBlock>

            <!-- Variant Rampart -->
            <controls:SettingsBlock Margin="0,5"
                                    Background="{DynamicResource ClassSelectorBackground}">
                <StackPanel Margin="5">
                    <TextBlock Style="{DynamicResource TextBlockSection}"
                               Text="{x:Static properties:Resources.VariantDungeon_Text_Defense}"/>

                    <StackPanel Margin="5"
                                Orientation="Horizontal">
                        <CheckBox Content="{x:Static properties:Resources.VariantDungeon_Content_UseVariantRampart}"
                                  IsChecked="{Binding UseVariantRampart, Mode=TwoWay}"
                                  Style="{DynamicResource CheckBoxFlat}"/>
                        <controls:Numeric Value="{Binding VariantRampartHealthPercent, Mode=TwoWay}"
                                         Margin="5,0,0,0"
                                         MaxValue="100"
                                         MinValue="1"/>
                    </StackPanel>

                    <TextBlock Margin="5"
                               Style="{DynamicResource TextBlockDefault}"
                               TextWrapping="Wrap"
                               FontStyle="Italic"
                               Foreground="LightBlue"
                               Text="{x:Static properties:Resources.VariantDungeon_Text_VariantRampartDescription}"/>

                    <!-- Variant Eagle Eye Shot (under defense since it's a general combat ability) -->
                    <StackPanel Margin="5"
                                Orientation="Horizontal">
                        <CheckBox Content="{x:Static properties:Resources.VariantDungeon_Content_UseVariantEagleEyeShot}"
                                  IsChecked="{Binding UseVariantEagleEyeShot, Mode=TwoWay}"
                                  Style="{DynamicResource CheckBoxFlat}"/>
                    </StackPanel>

                    <TextBlock Margin="5"
                               Style="{DynamicResource TextBlockDefault}"
                               TextWrapping="Wrap"
                               FontStyle="Italic"
                               Foreground="LightBlue"
                               Text="{x:Static properties:Resources.VariantDungeon_Text_VariantEagleEyeShotDescription}"/>
                </StackPanel>
            </controls:SettingsBlock>

        </StackPanel>
    </ScrollViewer>

</UserControl>
