<UserControl x:Class="Magitek.Views.UserControls.BeastMaster.Rotation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:properties="clr-namespace:Magitek.Properties"
             xmlns:controls="clr-namespace:Magitek.Controls"
             xmlns:viewModels="clr-namespace:Magitek.ViewModels">
    <UserControl.DataContext>
        <Binding Source="{x:Static viewModels:BaseSettings.Instance}" />
    </UserControl.DataContext>
    <UserControl.Resources>
        <ResourceDictionary Source="/Magitek;component/Styles/Magitek.xaml" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <controls:SettingsBlock Margin="0,5,0,0" Background="{DynamicResource ClassSelectorBackground}">
                <StackPanel>
                    <TextBlock Style="{DynamicResource TextBlockSection}" Text="{x:Static properties:Resources.BeastMaster_Text_Familiar}"/>
                    <StackPanel Margin="5">
                        <StackPanel Margin="5" Orientation="Horizontal">
                            <CheckBox Content="{x:Static properties:Resources.BeastMaster_Content_Summon}" IsChecked="{Binding BeastMasterSettings.SummonFamiliar, Mode=TwoWay}" Style="{DynamicResource CheckBoxFlat}" />
                            <controls:Numeric MaxValue="3" MinValue="1" Value="{Binding BeastMasterSettings.PreferredBattlehorn, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Margin="5">
                            <CheckBox Content="{x:Static properties:Resources.BeastMaster_Content_Tempered_Release}" IsChecked="{Binding BeastMasterSettings.UseTemperedRelease, Mode=TwoWay}" Style="{DynamicResource CheckBoxFlat}" />
                        </StackPanel>
                        <StackPanel Margin="5">
                            <CheckBox Content="{x:Static properties:Resources.BeastMaster_Content_TR_Knockbacks}" IsChecked="{Binding BeastMasterSettings.TemperedReleaseKnockbacksInParty, Mode=TwoWay}" Style="{DynamicResource CheckBoxFlat}" />
                        </StackPanel>
                        <StackPanel Margin="5" Orientation="Horizontal">
                            <TextBlock Style="{DynamicResource TextBlockDefault}" Text="{x:Static properties:Resources.BeastMaster_Content_TR_Mitigation}" />
                            <controls:Numeric MaxValue="100" MinValue="1" Value="{Binding BeastMasterSettings.TemperedReleaseMitigationHealthPercent, Mode=TwoWay}" />
                            <TextBlock Style="{DynamicResource TextBlockDefault}" Text="{x:Static properties:Resources.Generic_Percent}" />
                        </StackPanel>
                        <StackPanel Margin="5">
                            <CheckBox Content="{x:Static properties:Resources.BeastMaster_Content_Sleep_Disengage}" IsChecked="{Binding BeastMasterSettings.DisengageAfterSleep, Mode=TwoWay}" Style="{DynamicResource CheckBoxFlat}" />
                        </StackPanel>
                        <StackPanel Margin="5" Orientation="Horizontal">
                            <TextBlock Style="{DynamicResource TextBlockDefault}" Text="{x:Static properties:Resources.BeastMaster_Content_TR_Sleep}" />
                            <controls:Numeric MaxValue="10" MinValue="1" Value="{Binding BeastMasterSettings.TemperedReleaseSleepMinEnemies, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Margin="5" Orientation="Horizontal">
                            <TextBlock Style="{DynamicResource TextBlockDefault}" Text="{x:Static properties:Resources.BeastMaster_Content_TR_Finisher}" />
                            <controls:Numeric MaxValue="100" MinValue="1" Value="{Binding BeastMasterSettings.TemperedReleaseFinisherHealthPercent, Mode=TwoWay}" />
                            <TextBlock Style="{DynamicResource TextBlockDefault}" Text="{x:Static properties:Resources.Generic_Percent}" />
                        </StackPanel>
                        <StackPanel Margin="5">
                            <CheckBox Content="{x:Static properties:Resources.BeastMaster_Content_Borrow}" IsChecked="{Binding BeastMasterSettings.UseBorrow, Mode=TwoWay}" Style="{DynamicResource CheckBoxFlat}" />
                        </StackPanel>
                        <StackPanel Margin="5">
                            <CheckBox Content="{x:Static properties:Resources.BeastMaster_Content_Prefer_Borrow}" IsChecked="{Binding BeastMasterSettings.PreferBorrow, Mode=TwoWay}" Style="{DynamicResource CheckBoxFlat}" />
                        </StackPanel>
                        <StackPanel Margin="5">
                            <CheckBox Content="{x:Static properties:Resources.BeastMaster_Content_Trick}" IsChecked="{Binding BeastMasterSettings.UseTrick, Mode=TwoWay}" Style="{DynamicResource CheckBoxFlat}" />
                        </StackPanel>
                        <StackPanel Margin="5">
                            <CheckBox Content="{x:Static properties:Resources.BeastMaster_Content_Parting_Blow}" IsChecked="{Binding BeastMasterSettings.UsePartingBlow, Mode=TwoWay}" Style="{DynamicResource CheckBoxFlat}" />
                        </StackPanel>
                        <StackPanel Margin="5">
                            <CheckBox Content="{x:Static properties:Resources.BeastMaster_Content_Parting_Blow_Vantage}" IsChecked="{Binding BeastMasterSettings.PartingBlowOnlyWithVantage, Mode=TwoWay}" Style="{DynamicResource CheckBoxFlat}" />
                        </StackPanel>
                        <StackPanel Margin="5">
                            <CheckBox Content="{x:Static properties:Resources.BeastMaster_Content_Battlehorn_Swaps}" IsChecked="{Binding BeastMasterSettings.UseBattlehornSwaps, Mode=TwoWay}" Style="{DynamicResource CheckBoxFlat}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </controls:SettingsBlock>
            <controls:SettingsBlock Margin="0,5" Background="{DynamicResource ClassSelectorBackground}">
                <StackPanel>
                    <TextBlock Style="{DynamicResource TextBlockSection}" Text="{x:Static properties:Resources.BeastMaster_Text_Rotation}"/>
                    <StackPanel Margin="5">
                        <StackPanel Margin="5">
                            <CheckBox Content="{x:Static properties:Resources.BeastMaster_Content_Instinctual}" IsChecked="{Binding BeastMasterSettings.UseInstinctualSkills, Mode=TwoWay}" Style="{DynamicResource CheckBoxFlat}" />
                        </StackPanel>
                        <StackPanel Margin="5">
                            <CheckBox Content="{x:Static properties:Resources.BeastMaster_Content_Rally}" IsChecked="{Binding BeastMasterSettings.UseRally, Mode=TwoWay}" Style="{DynamicResource CheckBoxFlat}" />
                        </StackPanel>
                        <StackPanel Margin="5">
                            <CheckBox Content="{x:Static properties:Resources.BeastMaster_Content_Rallying_Cheer}" IsChecked="{Binding BeastMasterSettings.UseRallyingCheer, Mode=TwoWay}" Style="{DynamicResource CheckBoxFlat}" />
                        </StackPanel>
                        <StackPanel Margin="5" Orientation="Horizontal">
                            <CheckBox Content="{x:Static properties:Resources.BeastMaster_Content_Shield_Charge}" IsChecked="{Binding BeastMasterSettings.UseShieldCharge, Mode=TwoWay}" Style="{DynamicResource CheckBoxFlat}" />
                            <controls:Numeric MaxValue="3" MinValue="0" Value="{Binding BeastMasterSettings.ShieldChargeKeepCharges, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </controls:SettingsBlock>
            <controls:SettingsBlock Margin="0,5" Background="{DynamicResource ClassSelectorBackground}">
                <StackPanel>
                    <TextBlock Style="{DynamicResource TextBlockSection}" Text="{x:Static properties:Resources.BeastMaster_Text_Kinship}"/>
                    <StackPanel Margin="5">
                        <StackPanel Margin="5">
                            <CheckBox Content="{x:Static properties:Resources.BeastMaster_Content_Soul_Crush}" IsChecked="{Binding BeastMasterSettings.UseSoulCrush, Mode=TwoWay}" Style="{DynamicResource CheckBoxFlat}" />
                        </StackPanel>
                        <StackPanel Margin="5">
                            <CheckBox Content="{x:Static properties:Resources.BeastMaster_Content_Quelling_Wave}" IsChecked="{Binding BeastMasterSettings.UseQuellingWave, Mode=TwoWay}" Style="{DynamicResource CheckBoxFlat}" />
                        </StackPanel>
                        <StackPanel Margin="5">
                            <CheckBox Content="{x:Static properties:Resources.BeastMaster_Content_Scouring_Ash}" IsChecked="{Binding BeastMasterSettings.UseScouringAsh, Mode=TwoWay}" Style="{DynamicResource CheckBoxFlat}" />
                        </StackPanel>
                        <StackPanel Margin="5">
                            <CheckBox Content="{x:Static properties:Resources.BeastMaster_Content_Seedsower}" IsChecked="{Binding BeastMasterSettings.UseSeedsower, Mode=TwoWay}" Style="{DynamicResource CheckBoxFlat}" />
                        </StackPanel>
                        <StackPanel Margin="5" Orientation="Horizontal">
                            <CheckBox Content="{x:Static properties:Resources.BeastMaster_Content_Beastskin}" IsChecked="{Binding BeastMasterSettings.UseBeastskin, Mode=TwoWay}" Style="{DynamicResource CheckBoxFlat}" />
                            <CheckBox Margin="10,0,0,0" Content="{x:Static properties:Resources.BeastMaster_Content_Scaleskin}" IsChecked="{Binding BeastMasterSettings.UseScaleskin, Mode=TwoWay}" Style="{DynamicResource CheckBoxFlat}" />
                            <CheckBox Margin="10,0,0,0" Content="{x:Static properties:Resources.BeastMaster_Content_Vileskin}" IsChecked="{Binding BeastMasterSettings.UseVileskin, Mode=TwoWay}" Style="{DynamicResource CheckBoxFlat}" />
                        </StackPanel>
                        <StackPanel Margin="5" Orientation="Horizontal">
                            <TextBlock Style="{DynamicResource TextBlockDefault}" Text="{x:Static properties:Resources.BeastMaster_Content_Defensive_Health}" />
                            <controls:Numeric MaxValue="100" MinValue="1" Value="{Binding BeastMasterSettings.DefensiveKinshipHealthPercent, Mode=TwoWay}" />
                            <TextBlock Style="{DynamicResource TextBlockDefault}" Text="{x:Static properties:Resources.Generic_Percent}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </controls:SettingsBlock>
            <controls:SettingsBlock Margin="0,5" Background="{DynamicResource ClassSelectorBackground}">
                <StackPanel>
                    <TextBlock Style="{DynamicResource TextBlockSection}" Text="{x:Static properties:Resources.BeastMaster_Text_Bestiary}"/>
                    <StackPanel Margin="5">
                        <StackPanel Margin="5">
                            <CheckBox Content="{x:Static properties:Resources.BeastMaster_Content_Capture}" IsChecked="{Binding BeastMasterSettings.UseCapture, Mode=TwoWay}" Style="{DynamicResource CheckBoxFlat}" />
                        </StackPanel>
                        <StackPanel Margin="5">
                            <CheckBox Content="{x:Static properties:Resources.BeastMaster_Content_Capture_Hold}" IsChecked="{Binding BeastMasterSettings.HoldForCapture, Mode=TwoWay}" Style="{DynamicResource CheckBoxFlat}" />
                        </StackPanel>
                        <StackPanel Margin="5" Orientation="Horizontal">
                            <TextBlock Style="{DynamicResource TextBlockDefault}" Text="{x:Static properties:Resources.BeastMaster_Content_Capture_Health}" />
                            <controls:Numeric MaxValue="100" MinValue="1" Value="{Binding BeastMasterSettings.CaptureHealthPercent, Mode=TwoWay}" />
                            <TextBlock Style="{DynamicResource TextBlockDefault}" Text="{x:Static properties:Resources.Generic_Percent}" />
                        </StackPanel>
                        <StackPanel Margin="5" Orientation="Horizontal">
                            <TextBlock Style="{DynamicResource TextBlockDefault}" Text="{x:Static properties:Resources.BeastMaster_Content_Capture_Odds}" />
                            <controls:Numeric MaxValue="5" MinValue="1" Value="{Binding BeastMasterSettings.CaptureMinimumOdds, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </controls:SettingsBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
