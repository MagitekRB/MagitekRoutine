<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compile the production control with detached RB fixtures so regression
       checks need neither a game process nor proprietary runtime assemblies. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>10</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Magitek/Utilities/AoeControl.cs" Link="AoeControl.cs" />
  </ItemGroup>
</Project>
